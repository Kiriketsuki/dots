# btop Chrysaki theme — auto-generated
# Source: ~/.config/theme/theme.css (Chrysaki palette)
# Do not edit manually; run btop/scripts/update_colors.py to regenerate

# Main background, empty for terminal default
theme[main_bg]="#161821"

# Main text color
theme[main_fg]="#e0e2ea"

# Title color for boxes
theme[title]="#e0e2ea"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#1a8a6a"

# Background color of selected item in processes box
theme[selected_bg]="#2e3142"

# Foreground color of selected item in processes box
theme[selected_fg]="#e0e2ea"

# Color of inactive/disabled text
theme[inactive_fg]="#6a6e82"

# Misc colors for processes box
theme[proc_misc]="#3d95e0"

# Cpu box outline color
theme[cpu_box]="#14664e"

# Memory/disks box outline color
theme[mem_box]="#3a2068"

# Net up/down box outline color
theme[net_box]="#197278"

# Processes box outline color
theme[proc_box]="#122858"

# Box divider line and small boxes line color
theme[div_line]="#363a4f"

# Temperature graph colors
theme[temp_start]="#197278"
theme[temp_mid]="#C4861C"
theme[temp_end]="#8C2F39"

# CPU graph colors
theme[cpu_start]="#14664e"
theme[cpu_mid]="#1a8a6a"
