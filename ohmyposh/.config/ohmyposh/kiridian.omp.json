{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 2,
  "final_space": false,
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "session",
          "style": "powerline",
          "powerline_symbol": "",
          "foreground": "#FFFFFF",
          "background": "#E06C75",
          "template": "{{ if .SSHSession }}  {{ .UserName }}@{{ .HostName }} {{ end }}"
        },
        {
          "type": "path",
          "style": "powerline",
          "powerline_symbol": "",
          "foreground": "#FFFFFF",
          "background": "#61AFEF",
          "properties": {
            "style": "agnoster_short",
            "folder_separator_icon": "  ",
            "home_icon": "~",
            "max_depth": 4
          },
          "template": "  {{ .Path }} "
        },
        {
          "type": "git",
          "style": "powerline",
          "powerline_symbol": "",
          "foreground": "#1E1E1E",
          "background": "#98C379",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) (gt .Behind 0) }}#E5C07B{{ end }}"
          ],
          "properties": {
            "fetch_status": true,
            "fetch_stash_count": true,
            "fetch_upstream_icon": true,
            "branch_icon": " "
          },
          "template": " {{ .UpstreamIcon }}{{ .HEAD }}{{ if gt .Ahead 0 }}  {{ .Ahead }}{{ end }}{{ if gt .Behind 0 }}  {{ .Behind }}{{ end }}{{ if .Staging.Changed }}  {{ .Staging.String }}{{ end }}{{ if .Working.Changed }}  {{ .Working.String }}{{ end }}{{ if gt .StashCount 0 }}  {{ .StashCount }}{{ end }} "
        }
      ]
    },
    {
      "type": "rprompt",
      "alignment": "right",
      "segments": [
        {
          "type": "status",
          "style": "powerline",
          "powerline_symbol": "",
          "foreground": "#FFFFFF",
          "background": "#E06C75",
          "properties": {
            "always_enabled": false
          },
          "template": "  {{ .Code }} "
        },
        {
          "type": "executiontime",
          "style": "powerline",
          "powerline_symbol": "",
          "foreground": "#ABB2BF",
          "background": "#3E4452",
          "properties": {
            "threshold": 2000,
            "style": "roundrock",
            "always_enabled": false
          },
          "template": "  {{ .FormattedMs }} "
        },
        {
          "type": "jobs",
          "style": "powerline",
          "powerline_symbol": "",
          "foreground": "#ABB2BF",
          "background": "#3E4452",
          "template": "  {{ .Jobs }} "
        },
        {
          "type": "python",
          "style": "powerline",
          "powerline_symbol": "",
          "foreground": "#1E1E1E",
          "background": "#56B6C2",
          "properties": {
            "fetch_version": true,
            "display_mode": "context",
            "fetch_virtual_env": true
          },
          "template": "  {{ if .Venv }}({{ .Venv }}) {{ end }}{{ .Full }} "
        },
        {
          "type": "node",
          "style": "powerline",
          "powerline_symbol": "",
          "foreground": "#1E1E1E",
          "background": "#56B6C2",
          "properties": {
            "fetch_version": true,
            "display_mode": "context"
          },
          "template": "  {{ .Full }} "
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "#98C379",
          "foreground_templates": [
            "{{ if gt .Code 0 }}#E06C75{{ end }}"
          ],
          "background": "transparent",
          "template": "❯ "
        }
      ]
    }
  ]
}
