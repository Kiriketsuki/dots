# CLI tool aliases — managed by dots/zsh stow package
# Sourced from .zshrc

# dust: disk usage with bars on right and reasonable depth
alias dust='dust --bars-on-right'

# duf: disk usage with dark theme
alias duf='duf --theme dark'

# hexyl: hex viewer with color and bold borders
alias hexyl='hexyl --color=always --border=bold'
