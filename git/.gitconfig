[user]
    name = kiriketsuki
    email = kiriketsuki@gmail.com

[credential]
    helper = cache

[init]
    defaultBranch = main

# ~/dev → personal
[includeIf "gitdir:~/dev/"]
    path = ~/.gitconfig-personal

# ~/workdev → personal by default
[includeIf "gitdir:~/workdev/"]
    path = ~/.gitconfig-personal

# ~/workdev/Aurrigo → work (overrides personal above)
[includeIf "gitdir:~/workdev/Aurrigo/"]
    path = ~/.gitconfig-work

[color "status"]
    added = "#1a8a6a"
    changed = "#FBB13C"
    untracked = "#20969c"

[color "diff"]
    meta = "#FCC96A"
    old = "#b53f4a"
    new = "#1a8a6a"
    frag = "#7a52b3"

[alias]
    gone = !bash ~/dots/git/git-gone.sh
    track-all = !bash ~/dots/git/git-track-all.sh
[credential "https://github.com"]
	helper =
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !/usr/bin/gh auth git-credential
