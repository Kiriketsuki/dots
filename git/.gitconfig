[user]
    name = kiriketsuki
    email = kiriketsuki@gmail.com

[credential]
    helper = cache

[init]
    defaultBranch = main

# ~/dev → personal
[includeIf "gitdir:~/dev/"]
    path = ~/.gitconfig-personal

# ~/workdev → personal by default
[includeIf "gitdir:~/workdev/"]
    path = ~/.gitconfig-personal

# ~/workdev/Aurrigo → work (overrides personal above)
[includeIf "gitdir:~/workdev/Aurrigo/"]
    path = ~/.gitconfig-work

[color "status"]
    added = "#1a8a6a"
    changed = "#FBB13C"
    untracked = "#20969c"

[color "diff"]
    meta = "#FCC96A"
    old = "#b53f4a"
    new = "#1a8a6a"
    frag = "#7a52b3"

[log]
    # Chrysaki jewel-tone palette — cycles through branches in git graph
    # Gradient order: Emerald leads, then Teal, Blonde, Amethyst Lt, Error Lt, Teal Lt, Blonde Lit
    graphColors = bold #1a8a6a, bold #20969c, bold #FBB13C, bold #7a52b3, bold #b53f4a, bold #197278, bold #FCC96A, bold #583090

[alias]
    gone = !bash ~/dots/git/git-gone.sh
    track-all = !bash ~/dots/git/git-track-all.sh
[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[protocol "file"]
	allow = always
