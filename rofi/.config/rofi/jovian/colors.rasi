* {
    background:     #0f1117;
    background-alt: #161821;
    background-alpha: rgba(15, 17, 23, 0.85);
    foreground:     #e0e2ea;
    selected:       #1c1f2b;
    active:         #252836;
    urgent:         #2e3142;
    
    foreground-selected: #e0e2ea;
    foreground-active:   #e0e2ea;
    foreground-urgent:   #e0e2ea;
}
