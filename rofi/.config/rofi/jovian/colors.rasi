* {
    background:     #e9c46a;
    background-alt: #264653;
    background-alpha: rgba(233, 196, 106, 0.85);
    foreground:     #264653;
    selected:       #2a9d8f;
    active:         #f4a261;
    urgent:         #e76f51;
    
    foreground-selected: #000000;
