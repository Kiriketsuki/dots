* {
    background:     #353539;
    background-alt: #334d5e;
    background-alpha: rgba(53, 53, 57, 0.85);
    foreground:     #95b4ed;
    selected:       #95b4ed;
    active:         #2c6d96;
    urgent:         #4c443e;
    
    foreground-selected: #000000;
    foreground-active:   #ffffff;
    foreground-urgent:   #95b4ed;
}
